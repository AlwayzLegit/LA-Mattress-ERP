# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jetnine

# Redis
REDIS_URL=redis://localhost:6379

# Auth (better-auth)
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# Email (Resend) — leave RESEND_API_KEY blank in dev to use the in-memory
# transport (logs emails but never sends).
EMAIL_FROM=Jetnine <noreply@jetnine.local>

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Stripe Connect (Phase 2.1)
# Each merchant connects their own Stripe via OAuth; we only need the
# platform's keys here so the API can complete the OAuth handshake and
# call the Stripe API on behalf of the connected accounts.
# Without these, the StripeService runs in stub mode (deterministic
# fake account ids and always-succeed charges) so dev / tests still work.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/stripe/oauth/callback
STRIPE_WEBHOOK_SECRET=

# Stripe Billing (PLAN §15.5) — platform subscriptions for SaaS accounts.
# Uses the same STRIPE_SECRET_KEY (platform account). One product, two
# monthly per-location Prices, and a separate endpoint secret for
# POST /v1/billing/stripe/webhook. Without the key everything runs in stub
# mode; with the key but no prices, checkout is disabled.
STRIPE_PRICE_STARTER_PER_LOCATION=
STRIPE_PRICE_PRO_PER_LOCATION=
STRIPE_BILLING_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Human live chat: disabled until isolated staging is configured.
CHAT_ENABLED=false
CHAT_ENVIRONMENT=staging
CHAT_STAFF_ORIGINS=http://localhost:3000
# Dedicated worker only; never use production IDs/keys in previews.
CHAT_BUSINESS_ID=
ABLY_API_KEY=
