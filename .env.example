# Root .env.example — copied/sourced for shared local-dev defaults.
# Per-app values live in apps/api/.env.example and apps/web/.env.example.

# Database (used by packages/db scripts: db:migrate, db:reset, db:seed)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jetnine

# Redis (BullMQ / rate limiting)
REDIS_URL=redis://localhost:6379

# Human chat remains opt-in. Keep staging and production credentials separate.
CHAT_ENABLED=false
CHAT_ENVIRONMENT=staging
CHAT_STAFF_ORIGINS=http://localhost:3000
CHAT_PUSH_ENABLED=false
CHAT_VAPID_PUBLIC_KEY=
CHAT_VAPID_PRIVATE_KEY=
CHAT_VAPID_SUBJECT=
# Scope each supervised chat worker to one configured business.
CHAT_BUSINESS_ID=
